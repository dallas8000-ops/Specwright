# Specwright (SPECWRIGHT_ prefix)
SPECWRIGHT_FRONTEND_URL=http://localhost:5173
SPECWRIGHT_PUBLIC_API_URL=http://localhost:8080
SPECWRIGHT_PUBLIC_SITE_URL=http://localhost:8080

# Public catalog prices (displayed on /billing)
SPECWRIGHT_STARTER_PRICE_USD=29
SPECWRIGHT_PRO_PRICE_USD=79
SPECWRIGHT_PRO_TRIAL_DAYS=14

# GitHub
SPECWRIGHT_GITHUB_TOKEN=
SPECWRIGHT_GITHUB_WEBHOOK_SECRET=
# Semicolon-separated folders to search for local checkouts when connecting via GitHub URL
# SPECWRIGHT_LOCAL_REPO_SEARCH_ROOTS=C:\Software Projects;C:\dev

# AI polish + auto description fill / migration notes on scan (Pro+)
SPECWRIGHT_AI_API_KEY=
SPECWRIGHT_AI_AUTO_ON_SCAN=true
SPECWRIGHT_AI_AUTO_TESTS_ON_SCAN=true

# Zero-input connect defaults
SPECWRIGHT_AUTO_SCAN_ON_CREATE=true
SPECWRIGHT_AUTO_WATCH_ON_CREATE=true
SPECWRIGHT_AUTO_CI_SYNC_ON_SCAN=true
# Requires SPECWRIGHT_NOTION_API_KEY + SPECWRIGHT_NOTION_PARENT_PAGE_ID
SPECWRIGHT_AUTO_NOTION_ON_SCAN=false

# Stripe production
SPECWRIGHT_STRIPE_SECRET_KEY=
SPECWRIGHT_STRIPE_WEBHOOK_SECRET=
SPECWRIGHT_STRIPE_PRICE_ID_STARTER=
SPECWRIGHT_STRIPE_PRICE_ID_PRO=

# Never set true on a public demo — local engineering only
# SPECWRIGHT_BILLING_MOCK_MODE=true

# Autopilot: after each scan, scaffold all route tests, AI-fill gaps, sync CI, refresh score
SPECWRIGHT_AUTOPILOT_MODE=true
